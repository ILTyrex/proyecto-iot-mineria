# Copia este archivo como ".env" y ajusta los valores segun tu entorno.
# No uses estos valores de ejemplo en produccion.

# URL completa opcional para clientes o servicios que la necesiten.
TIMESCALE_SERVICE_URL=postgres://usuario:password@host.timescale.com:5432/base_datos?sslmode=require

# Datos de conexion a PostgreSQL / TimescaleDB
DB_USER=usuario
DB_PASSWORD=password
DB_HOST=host.timescale.com
DB_PORT=5432
DB_NAME=base_datos
DB_SSLMODE=require

# Clave que el ESP32 debe enviar en el header X-API-Key
API_KEY=pon-aqui-la-key

# Integracion de la pagina de chat con Langflow
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=e6d3ba85-cb78-4ef1-aa18-917413ca33a9
LANGFLOW_API_KEY=
